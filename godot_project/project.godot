; Engine configuration file.
; Godot 4.4 project for "Бип и его открытия" EP-001

config_version=5

[application]

config/name="Бип и его открытия"
config/description="Детский 3D-мультсериал. Серия 1: Бип и красный мячик."
run/main_scene="res://episodes/ep001/ep001_main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[audio]

driver/output_latency=15

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[editor]

movie_writer/movie_file="res://output/raw_movie.avi"
movie_writer/fps=30
movie_writer/mjpeg_quality=0.9

[filesystem]

import/blender/enabled=false

[layer_names]

3d_render/layer_1="world"
3d_render/layer_2="characters"
3d_render/layer_3="props"

[rendering]

renderer/rendering_method="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
environment/defaults/default_clear_color=Color(0.72, 0.84, 0.92, 1)

[bip]

episode/id="EP-001"
episode/title="Бип и красный мячик"
episode/duration_sec=180
episode/fps=30
render/mode="FINAL"
